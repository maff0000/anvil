#!/usr/bin/env python3
import argparse
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from anvil.contracts import load_benchmark
from anvil.models import RuntimeConfig
from anvil.reporting import write_jsonl, write_summary
from anvil.runner import run

parser = argparse.ArgumentParser()
parser.add_argument("benchmark")
parser.add_argument("--samples", type=int)
parser.add_argument("--mode", choices=("sequential", "concurrent"), default="sequential")
parser.add_argument("--concurrency", type=int)
parser.add_argument("--endpoint")
parser.add_argument("--model")
parser.add_argument("--timeout", type=float)
parser.add_argument("--output-tokens", type=int)
parser.add_argument("--think", choices=("true", "false"))
args = parser.parse_args()
benchmark = load_benchmark(args.benchmark)
base = RuntimeConfig.from_environment()
think = base.think if args.think is None else args.think == "true"
config = RuntimeConfig(endpoint=args.endpoint or base.endpoint, model=args.model or base.model, timeout_seconds=args.timeout or benchmark.timeout_seconds, output_tokens=args.output_tokens or benchmark.output_tokens, temperature=base.temperature, concurrency=args.concurrency or base.concurrency, samples=args.samples or base.samples, api_key=base.api_key, think=think)
records = []
batch = run(benchmark, config, config.samples, args.mode, config.concurrency, records.append)
stamp = __import__('datetime').datetime.now(__import__('datetime').timezone.utc).strftime('%Y%m%dT%H%M%SZ')
out = Path('results'); out.mkdir(exist_ok=True)
prefix = out / f'{benchmark.benchmark_id}-{args.mode}-{stamp}'
write_jsonl(prefix.with_suffix('.jsonl'), records)
write_summary(prefix.with_suffix('.md'), records, batch, args.mode)
print(prefix.with_suffix('.md'))
