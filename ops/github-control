#!/usr/bin/env python3
"""Thin GitHub issue poller for bounded Axiom PL wake/resume."""
import argparse
import json
import os
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from anvil.github_control import parse_comments

parser = argparse.ArgumentParser()
parser.add_argument("--repo", default="maff0000/anvil")
parser.add_argument("--issue", type=int, default=1)
parser.add_argument("--state", default="/tmp/anvil-github-control-issue-1.json")
parser.add_argument("--interval", type=float, default=30.0)
parser.add_argument("--once", action="store_true")
parser.add_argument("--baseline", action="store_true", help="record the current latest comment without invoking a resume")
parser.add_argument("--launch-command", default="/usr/local/bin/axel -C /srv/codex/anvil exec --ephemeral --sandbox read-only -", help="argv string for a fresh stateless PL invocation; bootstrap is passed on stdin")
args = parser.parse_args()


def log(status, **fields):
    record = {"timestamp": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"), "component": "anvil-github-control", "repo": args.repo, "issue": args.issue, "status": status, **fields}
    print(json.dumps(record, ensure_ascii=False), flush=True)


def fetch():
    command = ["gh", "api", f"repos/{args.repo}/issues/{args.issue}/comments", "--paginate"]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(f"GitHub read failed: {result.stderr.strip()[-500:]}")
    payload = []
    for line in result.stdout.splitlines():
        if line.strip():
            value = json.loads(line)
            payload.extend(value if isinstance(value, list) else [value])
    return payload


def read_state():
    location = Path(args.state)
    if not location.exists():
        return {"last_comment_id": 0}
    return json.loads(location.read_text(encoding="utf-8"))


def write_state(comment_id):
    location = Path(args.state)
    location.parent.mkdir(parents=True, exist_ok=True)
    temporary = location.with_suffix(location.suffix + ".tmp")
    temporary.write_text(json.dumps({"last_comment_id": comment_id}, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(location)


def poll_once():
    state = read_state()
    comments = fetch()
    if args.baseline and not Path(args.state).exists():
        latest = max((int(item["id"]) for item in comments), default=0)
        write_state(latest)
        log("baseline", last_comment_id=latest)
        return 0
    messages = parse_comments(comments, int(state.get("last_comment_id", 0)))
    if not messages:
        log("idle", last_comment_id=state.get("last_comment_id", 0))
        return 0
    command = shlex.split(args.launch_command)
    if not command:
        log("blocked", error_code="RESUME_HOOK_EMPTY", message="resume command parsed empty", comment_id=messages[0].comment_id)
        return 3
    for message in messages:
        environment = os.environ.copy()
        environment.update({"ANVIL_GITHUB_COMMENT_ID": str(message.comment_id), "ANVIL_GITHUB_MESSAGE": message.body, "ANVIL_GITHUB_REPO": args.repo, "ANVIL_GITHUB_ISSUE": str(args.issue)})
        bootstrap = f"""You are a fresh, disposable Axiom PL invocation for ANVIL. Do not rely on prior session memory. Reconstruct truth only from durable state.

Read /srv/codex/anvil/README.md, docs/OPERATING-MODEL.md, docs/GITHUB-COMMS.md, docs/CAPABILITY-MATRIX.md, current Git branch and HEAD, the current open PR, and the latest messages on GitHub issue #{args.issue} in repository {args.repo}. Identify the exact pending CGPT_* ruling below.

Pending CGPT message:
{message.body}

Perform one small deterministic action proving correct rehydration: verify the current branch/HEAD and that the ruling selects no capability expansion. Then post exactly one concise AXIOM_CHECKPOINT comment to issue #{args.issue} using gh, including UTC, current SHA, consumed CGPT comment ID: {message.comment_id}, the ruling, the deterministic action, and resulting state. Do not edit files, run benchmarks, change production, or post any other comment. Return a concise result.
"""
        log("fresh_start", comment_id=message.comment_id, command=command[0])
        result = subprocess.run(command, env=environment, input=bootstrap, text=True, capture_output=True)
        if result.returncode:
            log("fresh_failed", error_code="FRESH_INVOCATION_FAILED", comment_id=message.comment_id, returncode=result.returncode, stderr_tail=result.stderr[-500:])
            return result.returncode or 4
        checkpoints = [item for item in fetch() if int(item["id"]) > int(state.get("last_comment_id", 0)) and str(item.get("body", "")).startswith("AXIOM_CHECKPOINT") and f"Consumed CGPT comment ID: {message.comment_id}" in str(item.get("body", ""))]
        if not checkpoints:
            log("fresh_failed", error_code="CHECKPOINT_NOT_CONFIRMED", message="fresh PL exited successfully but did not post the required checkpoint", comment_id=message.comment_id)
            return 6
        write_state(message.comment_id)
        log("fresh_complete", comment_id=message.comment_id, checkpoint_id=int(checkpoints[-1]["id"]))
    return 0


while True:
    try:
        code = poll_once()
    except Exception as exc:
        log("error", error_code="POLL_FAILED", message=str(exc))
        code = 5
    if args.once or code not in (0,):
        raise SystemExit(code)
    time.sleep(args.interval)
